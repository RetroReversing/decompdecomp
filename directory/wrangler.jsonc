{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decompdecomp-directory",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-04",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "decompdecomp-directory", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "decompdecomp-directory-snapshots" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
}
